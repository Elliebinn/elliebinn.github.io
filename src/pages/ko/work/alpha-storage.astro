<script is:inline>
  // 각 스크린샷에 브라우저 주소바 주입 (웹처럼 보이게)
  document.querySelectorAll('.shot').forEach(s=>{ if(s.querySelector('.addr')) return; const a=document.createElement('div'); a.className='addr'; a.textContent='alpha-storage.alphabridge.co.kr'; s.prepend(a); });

  const csNav = document.getElementById('csNav');
  window.addEventListener('scroll', () => { if (window.scrollY > 60) csNav.classList.add('scrolled'); else csNav.classList.remove('scrolled'); }, { passive:true });
  const obs = new IntersectionObserver((es)=>{ es.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('vis'); }); }, { threshold:0.08, rootMargin:'0px 0px -40px 0px' });
  document.querySelectorAll('.rv').forEach(el=>obs.observe(el));
  const countObs = new IntersectionObserver((es)=>{ es.forEach(en=>{ if(en.isIntersecting && !en.target.dataset.counted){ en.target.dataset.counted='1'; const t=parseInt(en.target.dataset.target); const dur=1400, start=performance.now(); const step=(now)=>{ const p=Math.min((now-start)/dur,1); const e=1-Math.pow(1-p,3); en.target.textContent=Math.floor(e*t); if(p<1) requestAnimationFrame(step); else en.target.textContent=t; }; requestAnimationFrame(step); } }); }, { threshold:0.3 });
  document.querySelectorAll('.count-up').forEach(el=>countObs.observe(el));
  const themeBtn = document.getElementById('csThemeBtn');
  themeBtn.addEventListener('click', ()=>{ const h=document.documentElement; const dark=h.getAttribute('data-theme')==='dark'; h.setAttribute('data-theme', dark?'light':'dark'); themeBtn.textContent = dark?'◐ Light':'◐ Dark'; });

  // scroll progress bar
  const prog = document.getElementById('prog');
  window.addEventListener('scroll', ()=>{ const h=document.documentElement; const max=h.scrollHeight-h.clientHeight; prog.style.width = max>0 ? (h.scrollTop/max*100)+'%' : '0%'; }, {passive:true});

  // interactive detail explorer
  const DE = {
    single: { title:'단일전략 상세 · 탭 3', tabs:[
      {t:'성과', img:'single-detail-perf.png', d:'IS/OS 구간 분리 + 12개 KPI. 누적수익·낙폭·월별·연도별 차트로 과적합 여부를 한 화면에서 판단합니다.'},
      {t:'보유종목', img:'single-holdings.png', d:'리밸 회차·기준일 두 축으로 스냅샷 탐색. target 대비 현재 보유의 괴리(pp)를 막대·눈금으로 표시합니다.'},
      {t:'변경 이력', p2:true, img:'single-history.png', d:'상태 전이와 필드별 before/after를 시간순으로. 사람 입력(좌측 선)과 시스템 자동 기록을 구분합니다.'},
    ]},
    composite: { title:'합성전략 상세 · 탭 4', tabs:[
      {t:'성과', img:'composite-detail-perf.png', d:'단일과 달리 IS/OS/LIVE 세그먼트 + LIVE 누적 차트, 복리/단리 토글까지. 실제 운영 성과를 증명합니다.'},
      {t:'구성', star:true, img:'composite-composition.png', d:'레그·비중·resid-IR 테이블 + 구성 변천 차트. 각 레그는 자기 단일전략 상세로 이동. 합성전략의 존재 이유입니다.'},
      {t:'보유종목', img:'composite-holdings.png', d:'15종목 집중 북. 레그 교체(구성 변경)가 보유 변화의 원인임을 화면에서 연결합니다.'},
      {t:'변경 이력', p2:true, img:'composite-history.png', d:'상태·정보 변경에 더해 공개·구성변경 이벤트까지. 구성 변경은 자동 버전(v1→v2→v3)으로 기록됩니다.'},
    ]},
  };
  let deKind='single';
  const deTitle=document.getElementById('deTitle'), deTabs=document.getElementById('deTabs'), deImg=document.getElementById('deImg'), deDesc=document.getElementById('deDesc');
  function deLabel(tab){ return tab.t + (tab.star?' <span style="color:#8688e1">★</span>':'') + (tab.p2?' <span style="opacity:.5;font-size:10px;font-weight:700">P2</span>':''); }
  function deRender(idx){
    const set=DE[deKind]; deTitle.textContent=set.title; deTabs.innerHTML='';
    set.tabs.forEach((tab,i)=>{
      const b=document.createElement('button');
      b.className='de-tab'+(i===idx?' active':''); b.innerHTML=deLabel(tab);
      b.onclick=()=>{ deImg.style.opacity='0'; setTimeout(()=>{ deImg.src='/images/alpha-storage/'+tab.img; deImg.style.opacity='1'; },150); deDesc.textContent=tab.d; deTabs.querySelectorAll('.de-tab').forEach((x,j)=>x.classList.toggle('active',j===i)); };
      deTabs.appendChild(b);
    });
    const t=set.tabs[idx]; deImg.src='/images/alpha-storage/'+t.img; deImg.style.opacity='1'; deDesc.textContent=t.d;
  }
  document.querySelectorAll('.de-seg').forEach(s=>s.addEventListener('click',()=>{ deKind=s.dataset.kind; document.querySelectorAll('.de-seg').forEach(x=>x.classList.toggle('active',x===s)); deRender(0); }));
  document.querySelector('.de-seg[data-kind="single"]').classList.add('active');
  deRender(0);
</script>

